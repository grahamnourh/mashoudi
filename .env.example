# Copie ce fichier en ".env" et remplace les valeurs ci-dessous

# Chaîne de connexion Postgres (Neon / Vercel Postgres). En local, crée une base
# Neon gratuite (ou "vercel storage add" si tu utilises la CLI Vercel) et colle
# son "POSTGRES_URL". Sur Vercel, cette variable est injectée automatiquement
# une fois la base attachée au projet.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# Longue chaîne aléatoire servant à signer les cookies de session (JWT).
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire

PORT=3000

# "development" en local (cookies envoyés en HTTP, donc localhost sans souci)
# "production" une fois déployé derrière un vrai HTTPS (Vercel le définit automatiquement).
NODE_ENV=development
